NODE_ENV=development
HOST=0.0.0.0
PORT=3100
DEPLOYMENT_MODE=selfhost
INSTANCE_NAME=Deek PM Self-hosted
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
DATABASE_URL=postgresql://root:change-me@127.0.0.1:5432/deek-pm
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
CORS_ORIGIN=*
ALLOW_REGISTRATION=false
SETUP_TOKEN=replace-with-a-random-setup-token-at-least-32-characters
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_NAME=Administrator
BOOTSTRAP_WORKSPACE=My Workspace
RUSTFS_ACCESS_KEY=replace-with-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-rustfs-secret-key
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
