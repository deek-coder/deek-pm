{
  "name": "deek-pm-app",
  "private": true,
  "version": "0.1.2",
  "description": "Deek PM desktop project knowledge manager",
  "author": "Deek PM",
  "license": "Apache-2.0",
  "repository": "https://github.com/deek-coder/deek-pm.git",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5179\" \"wait-on http://127.0.0.1:5179 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5179 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5179",
    "rebuild:native": "npm rebuild better-sqlite3-multiple-ciphers --runtime=electron --target=41.7.1 --disturl=https://electronjs.org/headers --ignore-scripts=false",
    "test:local": "electron scripts/test-local-repository.cjs",
    "test:migration": "tsx scripts/test-migration.ts",
    "test:update": "node --test electron/auto-updater.test.cjs",
    "migrate:legacy-assets": "electron scripts/migrate-legacy-inline-images.cjs",
    "build": "tsc -b && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "pm.deek.desktop",
    "productName": "Deek PM",
    "artifactName": "Deek-PM-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "deek-coder",
        "repo": "deek-pm",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "public/deek-logo-mark.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Deek-PM-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deek PM"
    },
    "portable": {
      "artifactName": "Deek-PM-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/lib-storage": "^3.1090.0",
    "@blocknote/code-block": "^0.51.3",
    "@blocknote/core": "^0.52.1",
    "@blocknote/mantine": "^0.51.3",
    "@blocknote/react": "^0.51.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.5",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "shadcn": "^4.8.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
